# ---- Application ----
# URL the dashboard is served at (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database ----
# SQLite (default for single-operator, portable deployment):
DATABASE_URL="file:./blogpilot.db"
# For PostgreSQL (production): provider-swappable schema
# DATABASE_URL="postgresql://user:password@localhost:5432/blogpilot?schema=public"

# ---- Auth ----
# 32+ char random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Initial operator account created by the seed script
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# ---- Credential encryption ----
# 32-byte (64 hex chars) AES-256 key used to encrypt stored API credentials
# (OpenRouter keys, WordPress application passwords). Held OUTSIDE the database.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this changes, previously stored credentials can no longer be decrypted.
APP_ENC_KEY=change-me-to-a-64-char-hex-encryption-key

# ---- Integration defaults (populated by later phases) ----
# Optional global OpenRouter API key used as a default for sites that do not
# override it per-site. Leave empty if not used.
OPENROUTER_API_KEY=
